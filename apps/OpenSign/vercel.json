{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "build",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    { "source": "/((?!assets/|static/|locales/|.*\\.).*)", "destination": "/index.html" }
  ]
}
